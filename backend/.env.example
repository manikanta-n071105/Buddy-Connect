# Backend Environment Configuration Example
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection (URL format recommended for cloud providers like Render / Railway / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/juniorconnect?sslmode=require

# Individual Database Options (Alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=juniorconnect
DB_SSL=false

# JWT Secret Keys (Generate strong random secrets for production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=7d

# CORS Allowed Origins (Comma-separated URLs of frontend domains)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://your-frontend.vercel.app
